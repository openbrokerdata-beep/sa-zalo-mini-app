# Lead API (apps/api). Local: http://localhost:8787 — domain này PHẢI nằm trong whitelist của Mini App.
VITE_API_BASE_URL=http://localhost:8787
# CDN ảnh (apps/api/public/media được deploy cùng API trên Vercel)
VITE_ASSET_BASE_URL=http://localhost:8787
# Zalo Official Account ID để openChat / followOA. TODO(khách hàng)
VITE_ZALO_OA_ID=
# Hotline hiển thị & gọi. TODO(khách hàng): chốt số chính thức (1800 6627 hay số đại lý)
VITE_HOTLINE=18006627
VITE_APP_VERSION=0.1.0

# Zalo Mini App ID — zmp-cli đọc biến này khi `zmp start -D` / `zmp deploy`.
# Lấy tại https://mini.zalo.me/developers sau khi tạo Mini App. (Không có tiền tố VITE_ → không lọt vào bundle.)
APP_ID=
