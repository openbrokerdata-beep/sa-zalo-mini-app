{
  "name": "@sa/miniapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zalo Mini App — Senturia An Phú (landing + thu lead)",
  "browserslist": [
    "Android >= 7",
    "iOS >= 13"
  ],
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zmp:login": "zmp login",
    "zmp:device": "zmp start -D",
    "deploy:dev": "pnpm build && zmp deploy --existing",
    "deploy:testing": "pnpm build && zmp deploy --existing --testing"
  },
  "dependencies": {
    "@sa/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "zmp-sdk": "^2.53.2",
    "zmp-ui": "1.11.15-2"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4",
    "zmp-cli": "^4.0.3",
    "zmp-vite-plugin": "^1.1.6"
  }
}
