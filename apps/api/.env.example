# ───────── Lead API (apps/api) ─────────
# local | staging | production
APP_ENV=local
PROJECT_SLUG=senturia-an-phu
LEAD_ID_PREFIX=SAP

# Origin được phép gọi API (phân tách dấu phẩy). Mini App chạy trong webview Zalo.
# TODO(verify): xác nhận origin thực tế của Mini App trên Zalo (xem docs/04-zalo-integration.md)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://h5.zdn.vn,https://h5.zadn.vn

# Danh sách sink đẩy lead (phân tách dấu phẩy): console | sheets | crm
LEAD_SINKS=console

# Bí mật nội bộ (sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
PHONE_PROOF_SECRET=change-me-32-bytes-hex
IP_HASH_SALT=change-me

# Rate limit lead theo IP
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=600

# ───────── Zalo ─────────
# App Secret Key: developers.zalo.me > Ứng dụng > Quản lý ứng dụng
ZALO_APP_ID=
ZALO_APP_SECRET=

# ───────── Google Sheets sink (chờ khách hàng cung cấp) ─────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Leads!A:Z
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Dán private key 1 dòng, giữ nguyên "\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ───────── CRM sink (chờ khách hàng cung cấp) ─────────
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_API_KEY=
