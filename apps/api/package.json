{
  "name": "@sa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lead API: nhận lead từ Zalo Mini App, xác thực, đẩy sang CRM + Google Sheets",
  "scripts": {
    "dev": "node --watch --import tsx src/dev.ts",
    "start": "tsx src/dev.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:preview": "vercel deploy",
    "deploy:prod": "vercel deploy --prod"
  },
  "dependencies": {
    "@sa/shared": "workspace:*",
    "google-auth-library": "^10.3.0",
    "hono": "^4.9.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.5",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
